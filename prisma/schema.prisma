generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  MANAGER
  VIEWER
}
enum Position {
  PM
  BrSE
  TL
  Developer
  Tester
}
enum Location {
  ONSITE
  OFFSHORE
}
enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  RESIGNED
}
enum Jlpt {
  N1
  N2
  N3
  N4
  N5
  NONE
}
enum ProjectStatus {
  PIPELINE
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}
enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  CLOUD
  DATABASE
  TESTING
  AI_TOOLS
  MANAGEMENT
  JAPANESE
}
enum ScenarioKind {
  CONSERVATIVE
  BASE
  OPTIMISTIC
}
enum AbsenceKind {
  LEAVE
  UNAVAILABLE
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(VIEWER)
  active Boolean @default(true)
  employeeId String? @unique
  sessionVersion Int @default(0)
  imports ImportBatch[]
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
}
model Employee {
  id String @id @default(cuid())
  code String @unique
  name String
  email String @unique
  position Position
  level Int
  joinDate DateTime @db.Date
  exitDate DateTime? @db.Date
  experience Decimal @db.Decimal(5,2)
  location Location @default(OFFSHORE)
  jlpt Jlpt @default(NONE)
  status EmploymentStatus @default(ACTIVE)
  participationRate Decimal @default(1) @db.Decimal(5,4)
  calendarId String?
  calendar WorkingCalendar? @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  user User?
  skills EmployeeSkill[]
  assignments ProjectAssignment[]
  managedProjects Project[] @relation("ProjectPM")
  absences EmployeeAbsence[]
  capacitySettings EmployeeCapacitySetting[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([position, status, location])
}
model Skill {
  id String @id @default(cuid())
  name String @unique
  category SkillCategory
  active Boolean @default(true)
  version Int @default(1)
  employees EmployeeSkill[]
  requirements ProjectSkillRequirement[]
  monthlyDemands MonthlySkillDemand[]
}
model EmployeeSkill {
  employeeId String
  skillId String
  proficiency Int
  active Boolean @default(true)
  version Int @default(1)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@id([employeeId, skillId])
}
model Project {
  id String @id @default(cuid())
  code String @unique
  name String
  customer String
  pmId String?
  pm Employee? @relation("ProjectPM", fields: [pmId], references: [id], onDelete: Restrict)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  status ProjectStatus @default(PIPELINE)
  contractedMm Decimal @db.Decimal(12,4)
  forecastMm Decimal @db.Decimal(12,4)
  requirements ProjectSkillRequirement[]
  assignments ProjectAssignment[]
  demands MonthlyProjectDemand[]
  probabilities ScenarioProjectProbability[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startDate, endDate])
}
model ProjectSkillRequirement {
  projectId String
  skillId String
  minProficiency Int
  requiredMm Decimal @db.Decimal(12,4)
  active Boolean @default(true)
  version Int @default(1)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@id([projectId, skillId])
}
model ProjectAssignment {
  id String @id @default(cuid())
  employeeId String
  projectId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  allocations MonthlyAllocation[]
  actuals MonthlyActualEffort[]
  @@unique([employeeId, projectId])
}
model MonthlyAllocation {
  id String @id @default(cuid())
  assignmentId String
  month DateTime @db.Date
  plannedMm Decimal @db.Decimal(12,4)
  version Int @default(1)
  assignment ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
  @@unique([assignmentId, month])
  @@index([month])
}
model MonthlyActualEffort {
  id String @id @default(cuid())
  assignmentId String
  month DateTime @db.Date
  actualMm Decimal @db.Decimal(12,4)
  version Int @default(1)
  assignment ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  @@unique([assignmentId, month])
  @@index([month])
}
model WorkingCalendar {
  id String @id @default(cuid())
  name String @unique
  days CalendarDay[]
  months CalendarMonth[]
  employees Employee[]
  capacitySettings EmployeeCapacitySetting[]
}
model CalendarDay {
  calendarId String
  date DateTime @db.Date
  workingFraction Decimal @db.Decimal(5,4)
  label String?
  calendar WorkingCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  @@id([calendarId, date])
}
model CalendarMonth {
  calendarId String
  month DateTime @db.Date
  standardDays Decimal @db.Decimal(5,2)
  version Int @default(1)
  calendar WorkingCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  @@id([calendarId, month])
}
model EmployeeAbsence {
  id String @id @default(cuid())
  employeeId String
  date DateTime @db.Date
  fraction Decimal @db.Decimal(5,4)
  reason String
  kind AbsenceKind @default(LEAVE)
  version Int @default(1)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@unique([employeeId, date])
}
model EmployeeCapacitySetting {
  employeeId String
  month DateTime @db.Date
  calendarId String
  participationRate Decimal @db.Decimal(5,4)
  version Int @default(1)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  calendar WorkingCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  @@id([employeeId, month])
  @@index([month])
}
model MonthlyProjectDemand {
  id String @id @default(cuid())
  projectId String
  month DateTime @db.Date
  demandMm Decimal @db.Decimal(12,4)
  version Int @default(1)
  skills MonthlySkillDemand[]
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@unique([projectId, month])
}
model MonthlySkillDemand {
  demandId String
  skillId String
  requiredMm Decimal @db.Decimal(12,4)
  minProficiency Int
  demand MonthlyProjectDemand @relation(fields: [demandId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@id([demandId, skillId])
}
model ForecastScenario {
  id String @id @default(cuid())
  name String @unique
  kind ScenarioKind @unique
  probabilities ScenarioProjectProbability[]
}
model ScenarioProjectProbability {
  scenarioId String
  projectId String
  probability Decimal? @db.Decimal(5,4)
  version Int @default(1)
  scenario ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@id([scenarioId, projectId])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  entity String
  entityId String
  action String
  before Json?
  after Json?
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
  @@index([createdAt, id])
  @@index([actorId, createdAt])
}
model ImportBatch {
  id String @id
  actorId String
  kind String
  rowCount Int
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
}
model LoginThrottle {
  key String @id
  attempts Int
  expiresAt DateTime
  @@index([expiresAt])
}
